{
  "apiVersion": "v1",
  "kind": "LimitRange",
  "metadata": {
    "name": "aegis-container-limits",
    "namespace": "aegis-hello-aegis-dev",
    "labels": {
      "aegis.io/app": "hello-aegis",
      "aegis.io/environment": "dev"
    }
  },
  "spec": {
    "limits": [
      {
        "type": "Container",
        "defaultRequest": {
          "cpu": "100m",
          "memory": "128Mi"
        },
        "default": {
          "cpu": "500m",
          "memory": "256Mi"
        },
        "max": {
          "cpu": "500m",
          "memory": "256Mi"
        }
      }
    ]
  }
}
