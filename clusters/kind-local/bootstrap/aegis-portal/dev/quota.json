{
  "apiVersion": "v1",
  "kind": "ResourceQuota",
  "metadata": {
    "name": "aegis-budget",
    "namespace": "aegis-aegis-portal-dev",
    "labels": {
      "aegis.io/app": "aegis-portal",
      "aegis.io/environment": "dev"
    }
  },
  "spec": {
    "hard": {
      "pods": "3",
      "requests.cpu": "300m",
      "requests.memory": "384Mi",
      "limits.cpu": "1500m",
      "limits.memory": "768Mi",
      "services": "1",
      "count/deployments.apps": "1",
      "count/serviceaccounts": "2"
    }
  }
}
